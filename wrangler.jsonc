{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trilink-energy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  }
}
